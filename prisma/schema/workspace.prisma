enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum AgreementStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
}

model ProjectTask {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  name      String
  url       String
  size      Int?
  type      String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String
  senderId  String
  content   String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model LegalAgreement {
  id            String               @id @default(cuid())
  projectId     String
  title         String?
  content       String?
  fileUrl       String?
  filePath      String?
  status        AgreementStatus      @default(DRAFT)
  auditMetadata Json?
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  signatures    AgreementSignature[]
  escrows       Escrow[]
}

model AgreementSignature {
  id          String         @id @default(cuid())
  agreementId String
  userId      String
  legalName   String
  signedAt    DateTime       @default(now())
  agreement   LegalAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  projectId String
  action    String
  details   String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
