enum NotificationType {
  INVITE
  SYSTEM
  PROJECT_CREATED
  TASK_ASSIGNED
  MESSAGE
  WALLET_FUNDED
  WITHDRAWAL_INITIATED
  WITHDRAWAL_COMPLETED
  CONNECTION_REQUEST
  STATUS_UPDATE
  ESCROW_PROPOSAL_CREATED
  ESCROW_APPROVED
  ESCROW_FUNDED
  MILESTONE_SUBMITTED
  MILESTONE_APPROVED
  MILESTONE_DISPUTED
  ESCROW_PAYMENT_RELEASED
  ESCROW_AUTO_RELEASED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String? // URL to navigate to (e.g. project workspace)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
}
