enum SubscriptionTier {
  FREE
  PREMIUM
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model UserProfile {
  id                      String                @id @default(cuid())
  email                   String                @unique
  password                String?
  googleId                String?               @unique
  isVerified              Boolean               @default(false)
  isAdmin                 Boolean               @default(false)
  identityVerified        Boolean               @default(false)
  legalName               String?
  displayName             String?
  firstName               String?
  lastName                String?
  avatarUrl               String?
  bio                     String?
  experience              String?
  skills                  String[]
  genres                  String[]
  portfolioLinks          String[]
  socialLinks             String[]
  phoneNumber             String?
  openToCollaborate       Boolean               @default(false)
  verificationToken       String?               @unique
  verificationTokenExpiry DateTime?
  resetToken              String?               @unique
  resetTokenExpiry        DateTime?
  onboardingCompleted     Boolean               @default(false)
  tier                    SubscriptionTier      @default(FREE)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  ownedProjects           Project[]             @relation("ProjectOwner")
  collaborations          ProjectCollaborator[]

  // Connections
  sentRequests     UserConnection[] @relation("RequestSender")
  receivedRequests UserConnection[] @relation("RequestReceiver")

  // Direct Message Relations
  sentDirectMessages      DirectMessage[]         @relation("DirectMessageSender")
  messageReactions        DirectMessageReaction[] @relation("DirectMessageReactionUser")
  directChatsAsUser1      DirectChat[]            @relation("DirectChatUser1")
  directChatsAsUser2      DirectChat[]            @relation("DirectChatUser2")
  sentMessageRequests     MessageRequest[]        @relation("MessageRequestSender")
  receivedMessageRequests MessageRequest[]        @relation("MessageRequestReceiver")

  // Endorsements
  givenEndorsements    Endorsement[] @relation("EndorsementSender")
  receivedEndorsements Endorsement[] @relation("EndorsementReceiver")

  // Audit Logs
  auditLogs AuditLog[]

  // Wallet & Payments
  wallet              Wallet?
  transactions        Transaction[]
  bankAccounts        BankAccount[]
  paymentRecords      PaymentRecord[]
}

model UserConnection {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     ConnectionStatus @default(PENDING)
  sender     UserProfile      @relation("RequestSender", fields: [senderId], references: [id])
  receiver   UserProfile      @relation("RequestReceiver", fields: [receiverId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
}
