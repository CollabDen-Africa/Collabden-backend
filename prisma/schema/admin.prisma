enum AdminRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
  FINANCE_ADMIN
  VERIFICATION_ADMIN
  MARKETPLACE_MODERATOR
}

model AdminUser {
  id       String    @id @default(cuid())
  email    String    @unique
  password String
  role     AdminRole @default(SUPPORT_ADMIN)

  // Session Security
  tokenVersion        Int           @default(0)
  accountStatus       AccountStatus @default(ACTIVE)
  failedLoginAttempts Int           @default(0)
  lockoutUntil        DateTime?
  lastActiveAt        DateTime      @default(now())

  // Password Reset
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Two-Factor Authentication
  isTwoFactorEnabled  Boolean   @default(true)
  twoFactorCode       String?
  twoFactorCodeExpiry DateTime?

  // Audit Logs & Notes
  adminAuditLogs AdminAuditLog[]
  adminNotes     AdminNote[]

  // Support Ticket Relations
  assignedSupportTickets  SupportTicket[]          @relation("AssignedSupportTickets")
  resolvedSupportTickets  SupportTicket[]          @relation("ResolvedSupportTickets")
  supportTicketMessages   SupportTicketMessage[]   @relation("SupportTicketMessages")
  supportAuditLogs        SupportTicketAuditLog[]  @relation("SupportAuditLogs")

  // Dispute Management Relations
  assignedDisputes        Dispute[]                @relation("AssignedDisputes")
  disputeDecisions        DisputeDecision[]
  disputeEvidenceRequests DisputeEvidenceRequest[]
  disputeMessages         DisputeMessage[]
  disputeAuditLogs        DisputeAuditLog[]

  // Verification Management Relations
  reviewedVerificationRequests IdentityVerificationRequest[] @relation("ReviewedVerificationRequests")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminNote {
  id                String          @id @default(cuid())
  adminId           String
  targetUserId      String?
  targetProjectId   String?
  targetAgreementId String?
  targetDisputeId   String?
  content           String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  admin             AdminUser       @relation(fields: [adminId], references: [id])
  targetUser        UserProfile?    @relation(fields: [targetUserId], references: [id])
  targetProject     Project?        @relation(fields: [targetProjectId], references: [id])
  targetAgreement   LegalAgreement? @relation(fields: [targetAgreementId], references: [id])
  targetDispute     Dispute?        @relation(fields: [targetDisputeId], references: [id])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  targetUserId String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  admin      AdminUser    @relation(fields: [adminId], references: [id])
  targetUser UserProfile? @relation("UserAdminAuditLogs", fields: [targetUserId], references: [id], onDelete: SetNull)
}

model AdminRoleConfig {
  id          String    @id @default(cuid())
  role        AdminRole @unique
  permissions String[]
  modules     String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
