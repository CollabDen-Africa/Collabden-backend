enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum CollaboratorRole {
  OWNER
  COLLABORATOR
}

model Project {
  id            String                @id @default(cuid())
  name          String
  description   String?
  genre         String
  startDate     DateTime
  endDate       DateTime?
  visibility    ProjectVisibility     @default(PUBLIC)
  status        ProjectStatus         @default(ACTIVE)
  ownerId       String
  owner         UserProfile           @relation("ProjectOwner", fields: [ownerId], references: [id])
  collaborators ProjectCollaborator[]
  tasks         ProjectTask[]
  files         ProjectFile[]
  messages      ProjectMessage[]
  agreements    LegalAgreement[]
  endorsements  Endorsement[]
  activities    ActivityLog[]
  escrow        Escrow?
  openToCollaborators Boolean               @default(false)
  requiredRoles       String[]
  requiredSkills      String[]
  applications        ProjectApplication[]
  metadata      Json?                 @default("{}")
  isDeleted     Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Administrative Actions
  disputes      Dispute[]
  reports       Report[]
  adminNotes    AdminNote[]
}

model ProjectCollaborator {
  id                 String           @id @default(cuid())
  projectId          String
  userId             String
  role               CollaboratorRole @default(COLLABORATOR)
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user               UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive           Boolean          @default(true)
  contributionRole   String?
  completedMusicLink String?
  isPinned           Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([projectId, userId])
}
