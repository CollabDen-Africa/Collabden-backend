// ─── Payment Enums ──────────────────────────────────────────────────────────

enum TransactionType {
  FUNDING
  WITHDRAWAL
  ESCROW_CREDIT
  ESCROW_DEBIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Wallet ─────────────────────────────────────────────────────────────────
// Stores the user's CollabDen wallet balance. One wallet per user.
// All amounts are in NGN. Uses Decimal for financial precision.

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("NGN")
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Transaction ────────────────────────────────────────────────────────────
// Immutable ledger of all wallet balance movements.
// Every credit or debit to a wallet creates a Transaction record.

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      Decimal           @db.Decimal(12, 2)
  balanceBefore Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @db.Decimal(12, 2)
  reference   String            @unique
  description String?
  metadata    Json?             @default("{}")
  user        UserProfile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([reference])
  @@index([type])
  @@index([status])
}

// ─── BankAccount ────────────────────────────────────────────────────────────
// Stores user-registered bank accounts for withdrawal payouts.
// Bank details are verified via Flutterwave before saving.

model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String
  isDefault     Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, bankCode, accountNumber])
  @@index([userId])
}

// ─── PaymentRecord ──────────────────────────────────────────────────────────
// Records all interactions with Flutterwave (funding payments & withdrawal payouts).
// Links Flutterwave references to internal transaction references.

model PaymentRecord {
  id              String   @id @default(cuid())
  userId          String
  txRef           String   @unique
  flwRef          String?
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("NGN")
  paymentMethod   String?
  status          String   @default("PENDING")
  type            String   // "FUNDING" or "PAYOUT"
  flutterwaveData Json?    @default("{}")
  user            UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([txRef])
}
