enum LoginStatus {
  SUCCESS
  FAILED
}

enum DataExportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  ACCOUNT
  BILLING
  TECHNICAL
  PROJECT
  COLLABORATION
  VERIFICATION
  DISPUTE
  OTHER
}

enum IdentityVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  INCOMPLETE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_RESPONSE
  RESOLVED
  CLOSED
}

enum DisputeCategory {
  PAYMENT
  ESCROW_MILESTONE
  AGREEMENT_RELATED
  PROJECT_COLLABORATION
  USER_CONDUCT
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

model LoginActivity {
  id        String      @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  status    LoginStatus @default(FAILED)
  createdAt DateTime    @default(now())

  user UserProfile @relation(fields: [userId], references: [id])
}

model DataExportRequest {
  id        String           @id @default(cuid())
  userId    String
  status    DataExportStatus @default(PENDING)
  fileUrl   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user UserProfile @relation(fields: [userId], references: [id])
}

model SupportTicket {
  id              String                @id @default(cuid())
  userId          String
  subject         String
  message         String
  category        SupportTicketCategory @default(OTHER)
  status          SupportTicketStatus   @default(OPEN)
  attachments     Json?                 @default("[]")
  assignedAdminId String?
  resolution      String?
  resolvedAt      DateTime?
  resolvedByAdminId String?
  firstResponseAt DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user             UserProfile            @relation(fields: [userId], references: [id])
  assignedAdmin    AdminUser?             @relation("AssignedSupportTickets", fields: [assignedAdminId], references: [id])
  resolvedByAdmin  AdminUser?             @relation("ResolvedSupportTickets", fields: [resolvedByAdminId], references: [id])
  messages         SupportTicketMessage[]
  auditLogs        SupportTicketAuditLog[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([assignedAdminId])
  @@index([resolvedByAdminId])
  @@index([resolvedAt])
  @@index([createdAt])
}

model SupportTicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  adminId    String
  message    String
  attachments Json?        @default("[]")
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin  AdminUser     @relation("SupportTicketMessages", fields: [adminId], references: [id])

  @@index([ticketId])
  @@index([adminId])
  @@index([createdAt])
}


model SupportTicketAuditLog {
  id             String                @id @default(cuid())
  ticketId       String
  adminId        String
  action         String                
  previousStatus SupportTicketStatus?
  newStatus      SupportTicketStatus?
  details        Json?                 @default("{}")
  createdAt      DateTime              @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin  AdminUser     @relation("SupportAuditLogs", fields: [adminId], references: [id])

  @@index([ticketId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model IdentityVerificationRequest {
  id                String                     @id @default(cuid())
  userId            String
  status            IdentityVerificationStatus @default(PENDING)
  verificationType  String                     @default("GOVERNMENT_ID")
  documents         Json?                      // Array of document URLs
  notes             String?
  rejectionReason   String?
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  user       UserProfile @relation(fields: [userId], references: [id])
  reviewedBy AdminUser?  @relation("ReviewedVerificationRequests", fields: [reviewedByAdminId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([verificationType])
  @@index([createdAt])
}

model Dispute {
  id              String                 @id @default(cuid())
  reporterId      String
  reportedUserId  String?
  projectId       String?
  transactionId   String?
  assignedAdminId String?
  category        DisputeCategory        @default(PROJECT_COLLABORATION)
  reason          String
  description     String?
  evidence        Json?                  @default("[]")
  status          DisputeStatus          @default(OPEN)
  isFinalized     Boolean                @default(false)
  resolvedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  reporter         UserProfile              @relation("DisputeReporter", fields: [reporterId], references: [id])
  reportedUser     UserProfile?             @relation("DisputeReportedUser", fields: [reportedUserId], references: [id])
  project          Project?                 @relation(fields: [projectId], references: [id])
  assignedAdmin    AdminUser?               @relation("AssignedDisputes", fields: [assignedAdminId], references: [id])
  adminNotes       AdminNote[]
  messages         DisputeMessage[]
  evidenceRequests DisputeEvidenceRequest[]
  decision         DisputeDecision?
  auditLogs        DisputeAuditLog[]

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([projectId])
  @@index([assignedAdminId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model DisputeDecision {
  id                  String   @id @default(cuid())
  disputeId           String   @unique
  adminId             String
  resolutionSummary   String
  outcome             String
  supportingNotes     String?
  financialAdjustment Json?    @default("{}")
  resolvedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  dispute Dispute   @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  admin   AdminUser @relation(fields: [adminId], references: [id])
}

model DisputeEvidenceRequest {
  id             String      @id @default(cuid())
  disputeId      String
  adminId        String
  requestedFrom  String
  requestDetails String
  dueDate        DateTime?
  status         String      @default("PENDING")
  responseNote   String?
  submittedFiles Json?       @default("[]")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  dispute    Dispute     @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  admin      AdminUser   @relation(fields: [adminId], references: [id])
  targetUser UserProfile @relation(fields: [requestedFrom], references: [id])

  @@index([disputeId])
}

model DisputeMessage {
  id            String       @id @default(cuid())
  disputeId     String
  senderAdminId String?
  senderUserId  String?
  message       String
  attachments   Json?        @default("[]")
  isInternal    Boolean      @default(false)
  createdAt     DateTime     @default(now())

  dispute     Dispute      @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderAdmin AdminUser?   @relation(fields: [senderAdminId], references: [id])
  senderUser  UserProfile? @relation(fields: [senderUserId], references: [id])

  @@index([disputeId])
}

model DisputeAuditLog {
  id             String         @id @default(cuid())
  disputeId      String
  adminId        String?
  userId         String?
  action         String
  previousStatus DisputeStatus?
  newStatus      DisputeStatus?
  details        Json?          @default("{}")
  createdAt      DateTime       @default(now())

  dispute Dispute      @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  admin   AdminUser?   @relation(fields: [adminId], references: [id])
  user    UserProfile? @relation(fields: [userId], references: [id])

  @@index([disputeId])
  @@index([createdAt])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  projectId      String?
  agreementId    String?
  reason         String
  description    String?
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter     UserProfile    @relation("ReportReporter", fields: [reporterId], references: [id])
  reportedUser UserProfile?   @relation("ReportReportedUser", fields: [reportedUserId], references: [id])
  project      Project?       @relation(fields: [projectId], references: [id])
  agreement    LegalAgreement? @relation(fields: [agreementId], references: [id])
}
